# ── Aruna Textile server environment ──
# Copy to .env and fill in. NEVER commit .env.

# Port for the API
PORT=4000

# Public URL of the storefront (used in email links)
SITE_URL=http://localhost:5173

# Supabase — the *server* key (service_role / secret key). Bypasses RLS; server only.
SUPABASE_URL=example
SUPABASE_SECRET_KEY=example
# (legacy) SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=aruna-images

# Razorpay — from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=example
RAZORPAY_KEY_SECRET=example
# Webhook secret — Razorpay Dashboard > Webhooks > your endpoint > copy secret
RAZORPAY_WEBHOOK_SECRET=example

# Shipping (flat fee until Shiprocket is confirmed)
SHIPPING_FLAT_FEE=499
FREE_SHIPPING_ABOVE=25000
COD_ENABLED=true
COD_FEE=0
UNPAID_ORDER_MINUTES=30
CRON_SECRET=ArunaTextiles
# Brevo transactional email — Brevo > Account > SMTP & API
BREVO_API_KEY=example
MAIL_FROM_EMAIL=sinhaabhi90@gmail.com
MAIL_FROM_NAME=Aruna-Textiles
# Gets a cc of new order / cancellation / refund emails
ADMIN_NOTIFY_EMAIL=sinhaabhi90@gmail.com



