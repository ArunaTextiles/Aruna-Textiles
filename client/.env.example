# Supabase (project URL + anon/publishable key) — used by the browser for auth + reads
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Razorpay public key id (safe in the browser)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Base URL for the backend API (leave blank in dev — Vite proxies /api to :4000)
VITE_API_URL=

# Custom-order drawer (optional): where "Send Request / Send on WhatsApp" go
VITE_ENQUIRY_EMAIL=
VITE_WHATSAPP_NUMBER=919999999999
