{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 3 * * *" }
  ]
}
